  <diagram name="Hình 1: Sơ đồ thực thể liên kết tài khoản và thiết lập" id="bGUYQUOkr7AdUjY3sRAi">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Tài khoản và thiết lập\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% nguoi_dung\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar email UK \&quot;NOT NULL\&quot;\n        bigint anh_dai_dien_id FK \&quot;NULL\&quot;\n    }\n    %% vai_tro\n    vai_tro {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar ma UK \&quot;NOT NULL\&quot;\n    }\n    %% nguoi_dung_vai_tro\n    %% nguoi_dung_vai_tro UNIQUE (nguoi_dung_id, vai_tro_id)\n    nguoi_dung_vai_tro {\n        bigint nguoi_dung_id PK, FK \&quot;NOT NULL\&quot;\n        bigint vai_tro_id PK, FK \&quot;NOT NULL\&quot;\n    }\n    %% danh_tinh_oauth\n    %% danh_tinh_oauth UNIQUE (nha_cung_cap, subject)\n    danh_tinh_oauth {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK \&quot;NOT NULL\&quot;\n        varchar nha_cung_cap UK \&quot;NOT NULL\&quot;\n        varchar subject UK \&quot;NOT NULL\&quot;\n    }\n    %% token_tai_khoan\n    token_tai_khoan {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK \&quot;NOT NULL\&quot;\n        char token_hash UK \&quot;NOT NULL\&quot;\n    }\n    %% ho_so_hoc_tap\n    ho_so_hoc_tap {\n        bigint nguoi_dung_id PK, FK \&quot;NOT NULL\&quot;\n    }\n    %% cai_dat_thong_bao\n    cai_dat_thong_bao {\n        bigint nguoi_dung_id PK, FK \&quot;NOT NULL\&quot;\n    }\n    %% tep_tin [tham chiếu ngoài nhóm]\n    tep_tin {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    tep_tin |o--o{ nguoi_dung : \&quot;anh_dai_dien_id\&quot;\n    nguoi_dung ||--o{ nguoi_dung_vai_tro : \&quot;nguoi_dung_id\&quot;\n    vai_tro ||--o{ nguoi_dung_vai_tro : \&quot;vai_tro_id\&quot;\n    nguoi_dung ||--o{ danh_tinh_oauth : \&quot;nguoi_dung_id\&quot;\n    nguoi_dung ||--o{ token_tai_khoan : \&quot;nguoi_dung_id\&quot;\n    nguoi_dung ||--o| ho_so_hoc_tap : \&quot;nguoi_dung_id\&quot;\n    nguoi_dung ||--o| cai_dat_thong_bao : \&quot;nguoi_dung_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="lfF1TtgnQlkwMMqNECdu-1">
