        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Bộ thẻ và nội dung\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% nguoi_dung\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar email UK \&quot;NOT NULL\&quot;\n        bigint anh_dai_dien_id FK \&quot;NULL\&quot;\n    }\n    %% chu_de\n    chu_de {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar ten UK \&quot;NOT NULL\&quot;\n    }\n    %% bo_the\n    bo_the {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint chu_so_huu_id FK \&quot;NOT NULL\&quot;\n        bigint chu_de_id FK \&quot;NULL\&quot;\n        bigint bo_nguon_id FK \&quot;NULL\&quot;\n    }\n    %% the_tu_vung\n    the_tu_vung {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint bo_the_id FK \&quot;NOT NULL\&quot;\n    }\n    %% nhan\n    nhan {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar ten UK \&quot;NOT NULL\&quot;\n    }\n    %% the_nhan\n    %% the_nhan UNIQUE (the_id, nhan_id)\n    the_nhan {\n        bigint the_id PK, FK \&quot;NOT NULL\&quot;\n        bigint nhan_id PK, FK \&quot;NOT NULL\&quot;\n    }\n    %% tep_tin\n    tep_tin {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint chu_so_huu_id FK \&quot;NOT NULL\&quot;\n        varchar object_key UK \&quot;NOT NULL\&quot;\n    }\n    %% the_tep\n    %% the_tep UNIQUE (the_id, vai_tro)\n    the_tep {\n        bigint the_id PK, FK \&quot;NOT NULL\&quot;\n        bigint tep_id FK \&quot;NOT NULL\&quot;\n        varchar vai_tro PK \&quot;NOT NULL\&quot;\n    }\n    tep_tin |o--o{ nguoi_dung : \&quot;anh_dai_dien_id\&quot;\n    nguoi_dung ||--o{ tep_tin : \&quot;chu_so_huu_id\&quot;\n    nguoi_dung ||--o{ bo_the : \&quot;chu_so_huu_id\&quot;\n    chu_de |o--o{ bo_the : \&quot;chu_de_id\&quot;\n    bo_the |o--o{ bo_the : \&quot;bo_nguon_id\&quot;\n    bo_the ||--o{ the_tu_vung : \&quot;bo_the_id\&quot;\n    the_tu_vung ||--o{ the_nhan : \&quot;the_id\&quot;\n    nhan ||--o{ the_nhan : \&quot;nhan_id\&quot;\n    the_tu_vung ||--o{ the_tep : \&quot;the_id\&quot;\n    tep_tin ||--o{ the_tep : \&quot;tep_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mSCNCursySlEBwQSPp_P-1">
