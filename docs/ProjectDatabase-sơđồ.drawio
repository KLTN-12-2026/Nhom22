  <diagram id="ueklvbQBgAcbY9coBka2" name="Sơ đồ thực thể liên kết học srs và lịch sử">
    <mxGraphModel dx="1623" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Học SRS và lịch sử\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% tien_do_the\n    %% tien_do_the UNIQUE (nguoi_dung_id, the_id, chieu_hoc)\n    tien_do_the {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        bigint the_id FK, UK \&quot;NOT NULL\&quot;\n        varchar chieu_hoc UK \&quot;NOT NULL\&quot;\n    }\n    %% phien_hoc\n    phien_hoc {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK \&quot;NOT NULL\&quot;\n    }\n    %% phien_hoc_the\n    %% phien_hoc_the UNIQUE (phien_id, thu_tu)\n    phien_hoc_the {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint phien_id FK, UK \&quot;NOT NULL\&quot;\n        bigint the_id FK \&quot;NOT NULL\&quot;\n        bigint tien_do_id FK \&quot;NOT NULL\&quot;\n        int thu_tu UK \&quot;NOT NULL\&quot;\n    }\n    %% lich_su_on\n    %% lich_su_on UNIQUE (nguoi_dung_id, client_event_id)\n    lich_su_on {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        varchar client_event_id UK \&quot;NOT NULL\&quot;\n        bigint phien_id FK \&quot;NOT NULL\&quot;\n        bigint phien_the_id FK, UK \&quot;NOT NULL\&quot;\n        bigint tien_do_id FK \&quot;NOT NULL\&quot;\n    }\n    %% su_dung_hoc_ngay\n    %% su_dung_hoc_ngay UNIQUE (nguoi_dung_id, ngay_dia_phuong)\n    su_dung_hoc_ngay {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        date ngay_dia_phuong UK \&quot;NOT NULL\&quot;\n    }\n    %% nguoi_dung [tham chiếu ngoài nhóm]\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% the_tu_vung [tham chiếu ngoài nhóm]\n    the_tu_vung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    nguoi_dung ||--o{ tien_do_the : \&quot;nguoi_dung_id\&quot;\n    the_tu_vung ||--o{ tien_do_the : \&quot;the_id\&quot;\n    nguoi_dung ||--o{ phien_hoc : \&quot;nguoi_dung_id\&quot;\n    phien_hoc ||--o{ phien_hoc_the : \&quot;phien_id\&quot;\n    the_tu_vung ||--o{ phien_hoc_the : \&quot;the_id\&quot;\n    tien_do_the ||--o{ phien_hoc_the : \&quot;tien_do_id\&quot;\n    nguoi_dung ||--o{ lich_su_on : \&quot;nguoi_dung_id\&quot;\n    phien_hoc ||--o{ lich_su_on : \&quot;phien_id\&quot;\n    phien_hoc_the ||--o| lich_su_on : \&quot;phien_the_id\&quot;\n    tien_do_the ||--o{ lich_su_on : \&quot;tien_do_id\&quot;\n    nguoi_dung ||--o{ su_dung_hoc_ngay : \&quot;nguoi_dung_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7DY6AsaxdGDaqkQ-IFDt-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=16;fontStyle=0" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
