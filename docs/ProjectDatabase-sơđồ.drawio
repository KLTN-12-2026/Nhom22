  <diagram id="mP7xC8tvYyT4ncymLyhg" name="Hình 5: Sơ đồ thực thể liên kết bài luyện và cá nhân hóa">
    <mxGraphModel dx="3394" dy="2300" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Bài luyện và cá nhân hóa\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% bai_luyen\n    bai_luyen {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint chu_so_huu_id FK \&quot;NOT NULL\&quot;\n        bigint bo_the_id FK \&quot;NULL\&quot;\n        bigint yeu_cau_ai_id FK \&quot;NULL\&quot;\n    }\n    %% cau_hoi_bai_luyen\n    %% cau_hoi_bai_luyen UNIQUE (bai_id, thu_tu)\n    cau_hoi_bai_luyen {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint bai_id FK, UK \&quot;NOT NULL\&quot;\n        bigint the_id FK \&quot;NULL\&quot;\n        int thu_tu UK \&quot;NOT NULL\&quot;\n    }\n    %% lan_lam_bai\n    %% lan_lam_bai UNIQUE (nguoi_dung_id, submit_key)\n    lan_lam_bai {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        bigint bai_id FK \&quot;NOT NULL\&quot;\n        varchar submit_key UK \&quot;NOT NULL\&quot;\n    }\n    %% tra_loi_bai_luyen\n    %% tra_loi_bai_luyen UNIQUE (lan_id, cau_hoi_id)\n    tra_loi_bai_luyen {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint lan_id FK, UK \&quot;NOT NULL\&quot;\n        bigint cau_hoi_id FK, UK \&quot;NOT NULL\&quot;\n        bigint yeu_cau_ai_id FK \&quot;NULL\&quot;\n    }\n    %% loi_hoc_tap\n    %% loi_hoc_tap UNIQUE (lich_su_on_id, nhom_loi)\n    %% loi_hoc_tap UNIQUE (tra_loi_id, nhom_loi)\n    %% loi_hoc_tap UNIQUE (ket_qua_phat_am_id, nhom_loi)\n    loi_hoc_tap {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK \&quot;NOT NULL\&quot;\n        bigint the_id FK \&quot;NULL\&quot;\n        varchar nhom_loi UK \&quot;NOT NULL\&quot;\n        bigint lich_su_on_id FK, UK \&quot;NULL\&quot;\n        bigint tra_loi_id FK, UK \&quot;NULL\&quot;\n        bigint ket_qua_phat_am_id FK, UK \&quot;NULL\&quot;\n    }\n    %% so_tay_tu_kho\n    %% so_tay_tu_kho UNIQUE (nguoi_dung_id, the_id)\n    so_tay_tu_kho {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        bigint the_id FK, UK \&quot;NOT NULL\&quot;\n        bigint loi_id FK \&quot;NULL\&quot;\n    }\n    %% cap_tu_de_nham\n    %% cap_tu_de_nham UNIQUE (nguoi_dung_id, the_1_id, the_2_id, loai_nham)\n    cap_tu_de_nham {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        bigint the_1_id FK, UK \&quot;NOT NULL\&quot;\n        bigint the_2_id FK, UK \&quot;NOT NULL\&quot;\n        varchar loai_nham UK \&quot;NOT NULL\&quot;\n        bigint loi_id FK \&quot;NOT NULL\&quot;\n    }\n    %% nguoi_dung [tham chiếu ngoài nhóm]\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% bo_the [tham chiếu ngoài nhóm]\n    bo_the {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% yeu_cau_ai [tham chiếu ngoài nhóm]\n    yeu_cau_ai {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% the_tu_vung [tham chiếu ngoài nhóm]\n    the_tu_vung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% lich_su_on [tham chiếu ngoài nhóm]\n    lich_su_on {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% ket_qua_phat_am [tham chiếu ngoài nhóm]\n    ket_qua_phat_am {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    nguoi_dung ||--o{ bai_luyen : \&quot;chu_so_huu_id\&quot;\n    bo_the |o--o{ bai_luyen : \&quot;bo_the_id\&quot;\n    yeu_cau_ai |o--o{ bai_luyen : \&quot;yeu_cau_ai_id\&quot;\n    bai_luyen ||--o{ cau_hoi_bai_luyen : \&quot;bai_id\&quot;\n    the_tu_vung |o--o{ cau_hoi_bai_luyen : \&quot;the_id\&quot;\n    nguoi_dung ||--o{ lan_lam_bai : \&quot;nguoi_dung_id\&quot;\n    bai_luyen ||--o{ lan_lam_bai : \&quot;bai_id\&quot;\n    lan_lam_bai ||--o{ tra_loi_bai_luyen : \&quot;lan_id\&quot;\n    cau_hoi_bai_luyen ||--o{ tra_loi_bai_luyen : \&quot;cau_hoi_id\&quot;\n    yeu_cau_ai |o--o{ tra_loi_bai_luyen : \&quot;yeu_cau_ai_id\&quot;\n    nguoi_dung ||--o{ loi_hoc_tap : \&quot;nguoi_dung_id\&quot;\n    the_tu_vung |o--o{ loi_hoc_tap : \&quot;the_id\&quot;\n    lich_su_on |o--o{ loi_hoc_tap : \&quot;lich_su_on_id\&quot;\n    tra_loi_bai_luyen |o--o{ loi_hoc_tap : \&quot;tra_loi_id\&quot;\n    ket_qua_phat_am |o--o{ loi_hoc_tap : \&quot;ket_qua_phat_am_id\&quot;\n    nguoi_dung ||--o{ so_tay_tu_kho : \&quot;nguoi_dung_id\&quot;\n    the_tu_vung ||--o{ so_tay_tu_kho : \&quot;the_id\&quot;\n    loi_hoc_tap |o--o{ so_tay_tu_kho : \&quot;loi_id\&quot;\n    nguoi_dung ||--o{ cap_tu_de_nham : \&quot;nguoi_dung_id\&quot;\n    the_tu_vung ||--o{ cap_tu_de_nham : \&quot;the_1_id\&quot;\n    the_tu_vung ||--o{ cap_tu_de_nham : \&quot;the_2_id\&quot;\n    loi_hoc_tap ||--o{ cap_tu_de_nham : \&quot;loi_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="iFahnh2-ShBjpTSVLm7p-1">
