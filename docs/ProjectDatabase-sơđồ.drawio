  <diagram id="BzlLjI1RVcn-g_VLkmYH" name="Hình 6: Sơ đồ thực thể liên kết ai và phát âm">
    <mxGraphModel dx="1623" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% AI và phát âm\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% yeu_cau_ai\n    %% yeu_cau_ai UNIQUE (nguoi_dung_id, request_key)\n    yeu_cau_ai {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        varchar request_key UK \&quot;NOT NULL\&quot;\n    }\n    %% ban_nhap_the_ai\n    %% ban_nhap_the_ai UNIQUE (yeu_cau_id, thu_tu)\n    ban_nhap_the_ai {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint yeu_cau_id FK, UK \&quot;NOT NULL\&quot;\n        int thu_tu UK \&quot;NOT NULL\&quot;\n        bigint the_da_luu_id FK, UK \&quot;NULL\&quot;\n    }\n    %% han_muc_dich_vu\n    %% han_muc_dich_vu UNIQUE (nguoi_dung_id, loai_dich_vu)\n    han_muc_dich_vu {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        varchar loai_dich_vu UK \&quot;NOT NULL\&quot;\n    }\n    %% su_dung_dich_vu\n    su_dung_dich_vu {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK \&quot;NOT NULL\&quot;\n        bigint han_muc_id FK \&quot;NOT NULL\&quot;\n        bigint yeu_cau_ai_id FK, UK \&quot;NULL\&quot;\n        bigint ket_qua_phat_am_id FK, UK \&quot;NULL\&quot;\n    }\n    %% ket_qua_phat_am\n    %% ket_qua_phat_am UNIQUE (nguoi_dung_id, request_key)\n    ket_qua_phat_am {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        bigint the_id FK \&quot;NULL\&quot;\n        varchar request_key UK \&quot;NOT NULL\&quot;\n        bigint tep_ghi_am_id FK \&quot;NULL\&quot;\n    }\n    %% nguoi_dung [tham chiếu ngoài nhóm]\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% the_tu_vung [tham chiếu ngoài nhóm]\n    the_tu_vung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% tep_tin [tham chiếu ngoài nhóm]\n    tep_tin {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    nguoi_dung ||--o{ yeu_cau_ai : \&quot;nguoi_dung_id\&quot;\n    yeu_cau_ai ||--o{ ban_nhap_the_ai : \&quot;yeu_cau_id\&quot;\n    the_tu_vung |o--o| ban_nhap_the_ai : \&quot;the_da_luu_id\&quot;\n    nguoi_dung ||--o{ han_muc_dich_vu : \&quot;nguoi_dung_id\&quot;\n    nguoi_dung ||--o{ su_dung_dich_vu : \&quot;nguoi_dung_id\&quot;\n    han_muc_dich_vu ||--o{ su_dung_dich_vu : \&quot;han_muc_id\&quot;\n    yeu_cau_ai |o--o| su_dung_dich_vu : \&quot;yeu_cau_ai_id\&quot;\n    ket_qua_phat_am |o--o| su_dung_dich_vu : \&quot;ket_qua_phat_am_id\&quot;\n    nguoi_dung ||--o{ ket_qua_phat_am : \&quot;nguoi_dung_id\&quot;\n    the_tu_vung |o--o{ ket_qua_phat_am : \&quot;the_id\&quot;\n    tep_tin |o--o{ ket_qua_phat_am : \&quot;tep_ghi_am_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="3mylMA8gvTAFAYdnvVT8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=16;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
