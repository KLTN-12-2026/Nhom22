        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Quản trị và vận hành\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% bao_cao_noi_dung\n    bao_cao_noi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_bao_cao_id FK \&quot;NOT NULL\&quot;\n        bigint bo_the_id FK \&quot;NULL\&quot;\n        bigint the_id FK \&quot;NULL\&quot;\n        bigint yeu_cau_ai_id FK \&quot;NULL\&quot;\n        bigint nguoi_xu_ly_id FK \&quot;NULL\&quot;\n    }\n    %% nhat_ky_quan_tri\n    nhat_ky_quan_tri {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_thuc_hien_id FK \&quot;NULL\&quot;\n    }\n    %% tac_vu_nen\n    tac_vu_nen {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar khoa_chong_trung UK \&quot;NOT NULL\&quot;\n    }\n    %% yeu_cau_xoa_du_lieu\n    yeu_cau_xoa_du_lieu {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK \&quot;NULL\&quot;\n        varchar request_key UK \&quot;NOT NULL\&quot;\n    }\n    %% thong_ke_ngay\n    %% thong_ke_ngay UNIQUE (nguoi_dung_id, ngay_dia_phuong)\n    thong_ke_ngay {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        date ngay_dia_phuong UK \&quot;NOT NULL\&quot;\n    }\n    %% nguoi_dung [tham chiếu ngoài nhóm]\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% bo_the [tham chiếu ngoài nhóm]\n    bo_the {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% the_tu_vung [tham chiếu ngoài nhóm]\n    the_tu_vung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% yeu_cau_ai [tham chiếu ngoài nhóm]\n    yeu_cau_ai {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    nguoi_dung ||--o{ bao_cao_noi_dung : \&quot;nguoi_bao_cao_id\&quot;\n    bo_the |o--o{ bao_cao_noi_dung : \&quot;bo_the_id\&quot;\n    the_tu_vung |o--o{ bao_cao_noi_dung : \&quot;the_id\&quot;\n    yeu_cau_ai |o--o{ bao_cao_noi_dung : \&quot;yeu_cau_ai_id\&quot;\n    nguoi_dung |o--o{ bao_cao_noi_dung : \&quot;nguoi_xu_ly_id\&quot;\n    nguoi_dung |o--o{ nhat_ky_quan_tri : \&quot;nguoi_thuc_hien_id\&quot;\n    nguoi_dung |o--o{ yeu_cau_xoa_du_lieu : \&quot;nguoi_dung_id\&quot;\n    nguoi_dung ||--o{ thong_ke_ngay : \&quot;nguoi_dung_id\&quot;\n    %% tac_vu_nen.payload_ref phân giải nguồn tác vụ tại tầng nghiệp vụ.\n    %% nhat_ky_quan_tri.doi_tuong_id là tham chiếu đa hình, không khai báo FK.&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_HlhuYJij6t0njZKH39I-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=16;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
