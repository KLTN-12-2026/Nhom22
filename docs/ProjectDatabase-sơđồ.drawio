  <diagram id="cQ8pF6fNKcfquaNo0Y0f" name="Hình 3: Sơ đồ thực thể liên kết danh sách yêu thích">
    <mxGraphModel dx="1286" dy="848" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Danh sách yêu thích\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% bo_yeu_thich\n    %% bo_yeu_thich UNIQUE (nguoi_dung_id, bo_the_id)\n    bo_yeu_thich {\n        bigint nguoi_dung_id PK, FK \&quot;NOT NULL\&quot;\n        bigint bo_the_id PK, FK \&quot;NOT NULL\&quot;\n    }\n    %% chu_de_yeu_thich\n    %% chu_de_yeu_thich UNIQUE (nguoi_dung_id, chu_de_id)\n    chu_de_yeu_thich {\n        bigint nguoi_dung_id PK, FK \&quot;NOT NULL\&quot;\n        bigint chu_de_id PK, FK \&quot;NOT NULL\&quot;\n    }\n    %% nguoi_dung [tham chiếu ngoài nhóm]\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% bo_the [tham chiếu ngoài nhóm]\n    bo_the {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    %% chu_de [tham chiếu ngoài nhóm]\n    chu_de {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    nguoi_dung ||--o{ bo_yeu_thich : \&quot;nguoi_dung_id\&quot;\n    bo_the ||--o{ bo_yeu_thich : \&quot;bo_the_id\&quot;\n    nguoi_dung ||--o{ chu_de_yeu_thich : \&quot;nguoi_dung_id\&quot;\n    chu_de ||--o{ chu_de_yeu_thich : \&quot;chu_de_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="-y5fcDJyFrCh7xWKn98E-1">
