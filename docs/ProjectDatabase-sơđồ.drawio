  <diagram id="Cuk7uE_LK2ES1DdTQfcq" name="Hình 7: Sơ đồ thực thể liên kết điểm thưởng và thông báo">
    <mxGraphModel dx="1349" dy="914" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Điểm thưởng và thông báo\n    %% Bảng tham chiếu ngoài nhóm được đưa vào để đủ các FK trong phần mô tả Word.\n    %% UK trên nhiều thuộc tính là thành phần khóa ghép; xem UNIQUE trong chú thích.\n    %% huy_hieu\n    huy_hieu {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar ma UK \&quot;NOT NULL\&quot;\n    }\n    %% nguoi_dung_huy_hieu\n    %% nguoi_dung_huy_hieu UNIQUE (nguoi_dung_id, huy_hieu_id)\n    nguoi_dung_huy_hieu {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        bigint huy_hieu_id FK, UK \&quot;NOT NULL\&quot;\n    }\n    %% thu_thach\n    thu_thach {\n        bigint id PK \&quot;NOT NULL\&quot;\n        varchar ma UK \&quot;NOT NULL\&quot;\n    }\n    %% tien_do_thu_thach\n    %% tien_do_thu_thach UNIQUE (nguoi_dung_id, thu_thach_id)\n    tien_do_thu_thach {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        bigint thu_thach_id FK, UK \&quot;NOT NULL\&quot;\n    }\n    %% so_diem_thuong\n    %% so_diem_thuong UNIQUE (nguoi_dung_id, loai_su_kien, su_kien_id)\n    so_diem_thuong {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        varchar loai_su_kien UK \&quot;NOT NULL\&quot;\n        bigint su_kien_id UK \&quot;NOT NULL\&quot;\n    }\n    %% thong_bao\n    %% thong_bao UNIQUE (nguoi_dung_id, kenh, khoa_chong_trung)\n    thong_bao {\n        bigint id PK \&quot;NOT NULL\&quot;\n        bigint nguoi_dung_id FK, UK \&quot;NOT NULL\&quot;\n        varchar kenh UK \&quot;NOT NULL\&quot;\n        varchar khoa_chong_trung UK \&quot;NOT NULL\&quot;\n    }\n    %% nguoi_dung [tham chiếu ngoài nhóm]\n    nguoi_dung {\n        bigint id PK \&quot;NOT NULL\&quot;\n    }\n    nguoi_dung ||--o{ nguoi_dung_huy_hieu : \&quot;nguoi_dung_id\&quot;\n    huy_hieu ||--o{ nguoi_dung_huy_hieu : \&quot;huy_hieu_id\&quot;\n    nguoi_dung ||--o{ tien_do_thu_thach : \&quot;nguoi_dung_id\&quot;\n    thu_thach ||--o{ tien_do_thu_thach : \&quot;thu_thach_id\&quot;\n    nguoi_dung ||--o{ so_diem_thuong : \&quot;nguoi_dung_id\&quot;\n    nguoi_dung ||--o{ thong_bao : \&quot;nguoi_dung_id\&quot;\n    %% so_diem_thuong.su_kien_id là tham chiếu đa hình, không phải FK vật lý.\n    %% ON_TAP -&gt; lich_su_on.id; BAI_LUYEN -&gt; lan_lam_bai.id\n    %% HUY_HIEU -&gt; nguoi_dung_huy_hieu.id; THU_THACH -&gt; tien_do_thu_thach.id&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="eWyJ9ha9XOSmEdAD9gT6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=16;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="huy_hieu" mermaidId="n:huy_hieu" mermaidBaseStyle="shape=table;startSize=39.75;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontSize=16;fontFamily=Recursive;strokeWidth=2;align=center;resizeLast=1;html=1;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="huy_hieu" id="eWyJ9ha9XOSmEdAD9gT6-2">
          <mxCell parent="eWyJ9ha9XOSmEdAD9gT6-1" style="shape=table;startSize=39.75;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontSize=16;fontFamily=Recursive;strokeWidth=2;align=center;resizeLast=1;html=1;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
